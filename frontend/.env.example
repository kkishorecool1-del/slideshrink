# Frontend build-time API base URL
# For local development (uses Vite proxy in vite.config.ts):
# VITE_API_BASE=

# For Netlify production (set in Netlify UI → Site settings → Environment variables):
# VITE_API_BASE=https://your-backend-domain.com

# Example for Render:
# VITE_API_BASE=https://slideshrink-backend.onrender.com

# Example for Railway:
# VITE_API_BASE=https://slideshrink-production.up.railway.app

# Example for Fly.io:
# VITE_API_BASE=https://slideshrink.fly.dev

# Example for Hugging Face Spaces:
# VITE_API_BASE=https://your-username-slideshrink.hf.space