# railway.json - Deploy backend to Railway.app
# 1. Push this repo to GitHub
# 2. Go to https://railway.app → New Project → Deploy from GitHub repo
# 3. Select the backend directory as root

{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pip install -r requirements.txt"
  },
  "deploy": {
    "startCommand": "uvicorn app.main:app --host 0.0.0.0 --port $PORT",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  },
  "environments": {
    "production": {
      "variables": {
        "PYTHON_VERSION": "3.11",
        "SLIDESHRINK_CORS_ORIGINS": "https://your-site-name.netlify.app",
        "SLIDESHRINK_DATA_DIR": "/var/data/slideshrink",
        "SLIDESHRINK_JOB_TTL_SECONDS": "3600",
        "SLIDESHRINK_MAX_UPLOAD_BYTES": "104857600"
      }
    }
  }
}